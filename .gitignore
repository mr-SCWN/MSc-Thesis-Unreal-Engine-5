# =========================
# Unreal Engine (UE5) .gitignore
# Keep: Config/, Content/, Source/ (if any), *.uproject
# Ignore: Binaries, Intermediate, Saved, DerivedDataCache
# =========================

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.user
*.userprefs
*.sln
*.VC.db
*.VC.opendb

# Unreal generated folders
Binaries/
DerivedDataCache/
Intermediate/
Saved/

# Unreal build / logs / profiling outputs
*.log
*.tmp
*.cache
*.dmp
*.csv
Saved/Logs/
Saved/Profiling/
Saved/Temp/
Saved/Autosaves/
Saved/Crashes/

# Unreal project files (optional to ignore)
.vs/
Build/
*.opensdf
*.sdf
*.pdb
*.obj
*.ipch

# Packaging / staging
StagedBuilds/
Packaging/

# Optional: plugin intermediates
Plugins/**/Binaries/
Plugins/**/Intermediate/

# Optional: Rider/VS specific
.vsconfig